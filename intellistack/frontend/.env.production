# Production environment variables (public only - baked into static build)
# IMPORTANT: Set NEXT_PUBLIC_API_URL and NEXT_PUBLIC_AUTH_URL as Netlify env vars
# so they are available at build time without being committed to source control.
# Override these in Netlify dashboard: Site Settings > Environment variables

# Backend API URL (e.g. Railway: https://intellistack-backend.up.railway.app/api/v1)
NEXT_PUBLIC_API_URL=https://intellistack-backend.up.railway.app/api/v1

# Auth server URL (e.g. Railway: https://intellistack-auth.up.railway.app)
NEXT_PUBLIC_AUTH_URL=https://intellistack-auth.up.railway.app

# Docusaurus content site (GitHub Pages)
NEXT_PUBLIC_DOCUSAURUS_URL=https://saramali15792.github.io/AINativeBook/

